# Environment variables for CineTour backend
# Copy this file to .env and fill in the values

# TMDB API Token (Get it from https://www.themoviedb.org/settings/api)
# Use the "API Read Access Token" (Bearer token)
TMDB_API_TOKEN=your_tmdb_api_read_access_token_here

# Database configuration
NETWORK_DB_PASSWORD=_your_database_password_here

# Neo4j Database configuration (via SSH tunnel)
NEO4J_PASSWORD=neo4j_password_here